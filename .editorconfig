root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 250

[*.json]
insert_final_newline = false

[*.neon]
indent_size = 2

[compose*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[COMMIT_EDITMSG]
max_line_length = 0
